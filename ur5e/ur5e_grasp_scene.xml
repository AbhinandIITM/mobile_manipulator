<mujoco model="ur5e_grasp_scene">
  <include file="ur5e_gripper.xml"/>

  <statistic center="0 0 0.4" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <geom name="floor" pos="0 0 0" size="1.0 1.0 1" type="plane" material="matplane"/>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5" dir="0 0 -1" castshadow="false"/>
    <light mode="targetbodycom" target="base" directional="false" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 4.0" dir="0 0 -1"/>

    <!-- Object to grasp -->
    <body name="target_block" pos="-0.1 0.5 0.025">
      <freejoint/>
      <geom name="block_geom" type="box" size="0.02 0.02 0.025" rgba="0.8 0.2 0.2 1" friction="1.0 0.005 0.0001" mass="0.1"/>
    </body>
    
    <!-- Target Visual for IK tracking -->
    <body name="target" mocap="true" pos="-0.1 0.5 0.4">
      <geom name="target_sphere" type="sphere" size="0.02" rgba="1 1 0 0.5" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
